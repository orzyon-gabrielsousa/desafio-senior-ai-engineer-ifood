# Copie para .env (cp .env.example .env) e ajuste se precisar.

# Usuário do host dono dos arquivos criados pelo container do Hermes (id -u / id -g).
HERMES_UID=1000
HERMES_GID=1000

# Motor de inferência: llamacpp (padrão, suportado) ou max (experimental na RTX 50).
COMPOSE_PROFILES=llamacpp

# Porta do host para falar direto com a inferência (na rede do compose é sempre inference:8000).
INFERENCE_HOST_PORT=8010

# llama.cpp
LLAMA_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf   # ver `make model` / inference/llamacpp/README.md
MODEL_NAME=qwen3-8b                     # precisa bater com model.default do hermes-home/config.yaml
LLAMA_CTX=65536                         # o Hermes exige >= 64k
LLAMA_REASONING_BUDGET=0                # 0 = Qwen3 sem "thinking" (mais rápido); -1 = com thinking
LLAMA_N_PREDICT=4096                    # teto de tokens por resposta (evita geração sem fim e queda da GPU); -1 = sem teto

# Modular MAX (perfil max)
MAX_VERSION=26.7.0
MAX_MODEL=Qwen/Qwen3.5-4B
MAX_DEVICE_MEMORY=0.95   # fração da VRAM que o MAX pode planejar (o desktop usa ~3,5 GB dos 16 GB)
MAX_BATCH_SIZE=1

# Hermes
HERMES_IMAGE=nousresearch/hermes-agent:v0.23.1
SABOR_DA_MARIA_ORCAMENTO=80
API_SERVER_ENABLED=true
API_SERVER_KEY=sabor-da-maria-chave-local
API_SERVER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# O playground (React) sobe com `make up` nesta porta. A chave da API fica no nginx, não no navegador.
PLAYGROUND_HOST_PORT=3000
# Para ligar o webapp (chat no navegador, porta 9120): defina usuário/senha e
# troque webapp.enabled para true em hermes-home/config.yaml.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# SearXNG
SEARXNG_SECRET=troque-este-segredo-local
